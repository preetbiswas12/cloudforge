# Normalise line endings in the repository to LF.
# The Dockerfile and production runtime are Linux, where a stray CRLF inside a
# shell script or Dockerfile fails the build.
* text=auto eol=lf

# ...but keep native Windows line endings for Windows-only scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles and generated bundles: never touch line endings.
package-lock.json -text
*.svg binary
*.png binary
*.jpg binary
*.ico binary