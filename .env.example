# ---------------------------------------------------------------------------
# CloudForge configuration
# Copy to `.env` and edit. Every value below has a sane default.
# ---------------------------------------------------------------------------

# Port the HTTP server binds to. PaaS platforms inject PORT automatically.
PORT=8080

# Absolute or relative path to the folder that holds the user's files.
# On PaaS hosts, mount a volume here so files survive restarts (see README).
WORKSPACE_DIR=./workspace

# Directory containing the built web client (produced by `npm run build`).
WEB_DIST=./web/dist

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# The workspace is public by default: anyone who can reach the domain can edit.
# Set a token here to require it. Visitors then open:
#     https://your-domain.com/?token=YOUR_TOKEN
# The token is stored in their browser and sent as `x-editor-token`.
# Leave blank for a fully public editor.
EDITOR_TOKEN=

# ---------------------------------------------------------------------------
# Git integration (version history + off-host persistence)
# ---------------------------------------------------------------------------
GIT_ENABLED=true

# Repository identity used for automated commits.
GIT_AUTHOR_NAME=CloudForge
GIT_AUTHOR_EMAIL=cloudforge@localhost
GIT_BRANCH=main

# Remote repository used as the persistence + backup layer.
# Examples:
#   git@github.com:you/workspace.git
#   https://github.com/you/workspace.git
GIT_REMOTE=

# Optional token used to authenticate to the remote. It is injected into the
# remote URL at runtime, so no credentials are ever written to disk.
#   GitHub: a PAT or fine-grained token with `contents: read/write`
GIT_REMOTE_TOKEN=

# Pull the remote on boot. Strongly recommended on ephemeral PaaS disks.
GIT_PULL_ON_BOOT=true

# Automatically commit every few minutes while the editor is being used.
AUTO_COMMIT=true
SNAPSHOT_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Terminal / code execution
# ---------------------------------------------------------------------------
# CloudForge has two separate ways to run code:
#
#   1. Browser sandbox (ALWAYS available, zero server risk)
#      JavaScript/TypeScript and Python run inside a sandboxed iframe on an
#      opaque origin. The server is never involved. Press Ctrl+` then Run.
#
#   2. Server shell (below — opt-in, dangerous)
#      A real shell on this machine. It can read every file on the host,
#      run `npm install`, `node server.js`, and so on.
#
# Turn the server shell on only if you understand this. It is also refused at
# runtime unless EDITOR_TOKEN is set, so a wide-open instance can never hand
# out a shell.
TERMINAL_ENABLED=false

# Which binary to spawn. Defaults per platform:
#   Linux (Render/Railway/Fly): /bin/sh
#   Windows (local dev):        cmd.exe
# PowerShell is deliberately NOT the Windows default — it produces no output
# when stdin is a pipe rather than a real console.
# TERMINAL_SHELL=/bin/bash

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Largest file the editor will load or save, in bytes (default 2 MB).
MAX_FILE_BYTES=2097152

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info